  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "@types/sql.js": "^1.4.11",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "sql.js": "^1.14.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo start --android --dev-client",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "verify": "npm run typecheck && npm run lint && npm test",
    "build:dev-apk": "npx eas-cli@latest build --profile development --platform android",
    "build:preview-apk": "npx eas-cli@latest build --profile preview --platform android",
    "emulator": "node runonemulator.js",
    "emulator:fast": "node runonemulator.js --fast"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.ts?(x)"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg)"
    ],
    "testTimeout": 15000
  }
}
