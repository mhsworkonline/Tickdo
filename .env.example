# Copy to .env and fill in. Never commit .env.
# Only EXPO_PUBLIC_* values are bundled into the app; they must not be secrets.

# Supabase (Deliverable 6). Anon key is public by design; RLS protects data.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# RevenueCat (Deliverable 7). Public SDK key for Google Play.
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=

# Privacy policy URL shown in Settings.
EXPO_PUBLIC_PRIVACY_POLICY_URL=
